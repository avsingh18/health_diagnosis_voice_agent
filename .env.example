# Example environment file for the frontend (Vite)
# Copy this to .env in the project root for local development.
# VITE_BACKEND_URL is the URL of the FastAPI backend (Render will provide it).
VITE_BACKEND_URL=http://localhost:8000
# Secret key shared with backend (must match API_SECRET_KEY in backend/.env)
VITE_API_KEY=horizon-secure-key-2025
